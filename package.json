{
  "name": "git-log-digger",
  "displayName": "Git Log Digger",
  "publisher": "antigravity",
  "description": "Git Log Digger VS Code extension",
  "icon": "assets/icon.png",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/antigravity/git-log-digger.git"
  },
  "activationEvents": [
    "onCommand:git-log-digger.openHistory",
    "onCommand:git-log-digger.searchHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-log-digger.openHistory",
        "title": "Git Log Digger: Open File History",
        "icon": "$(history)"
      },
      {
        "command": "git-log-digger.searchHistory",
        "title": "Git Log Digger: Search File History (Pickaxe)",
        "icon": "$(search)"
      },
      {
        "command": "git-log-digger.checkForUpdates",
        "title": "Git Log Digger: Check for Updates",
        "icon": "$(cloud-download)"
      }
    ],
    "configuration": {
      "title": "Git Log Digger",
      "properties": {
        "git-log-digger.updateUrl": {
          "type": "string",
          "default": "https://script.google.com/a/macros/mail.chungyo.net/s/AKfycbyjUgrKcVpl0VXlGYhR6n8iB-S1mg27oIlSKu_aGW_5YKusyrhXCbmh2CA-NtzAvfOq/exec",
          "description": "Google Apps Script 或自訂更新伺服器 API 網址"
        },
        "git-log-digger.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "是否以分割視窗 (Beside) 呈現時光機，預設為關閉 (在當前分頁中開啟，不分割視窗)"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "git-log-digger.openHistory",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "git-log-digger.openHistory",
          "group": "7_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "git-log-digger.openHistory",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "build:extension": "node esbuild.js",
    "watch:extension": "node esbuild.js --watch",
    "build:webview": "npm --prefix webview-ui run build",
    "build": "npm run build:webview && npm run build:extension",
    "compile": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
